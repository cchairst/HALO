# Copy to .env.local and fill in. .env.local is gitignored.

# PostgreSQL database used by Prisma. Use your Railway Postgres connection string.
DATABASE_URL="postgresql://..."

# Privy - get from https://dashboard.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Demo identity switcher (off by default; real accounts come from Privy).
NEXT_PUBLIC_DEMO_MODE=0

# OpenAI - powers translation, medication lookup, and chart import
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Fast extraction/parsing default for translation, lookup, and chart import.
OPENAI_MODEL=gpt-5.4-nano

# Tambo - optional live generative-UI agent for the patient app.
# The UI toggle defaults OFF. Even with this key set, patients stay in
# local demo mode until they explicitly enable Tambo from the /ai toggle.
# Get a key at https://tambo.co
NEXT_PUBLIC_TAMBO_API_KEY=

# Resend - powers email broadcasts when a service agent proposes a service.
# Without these set the action still saves the offering and broadcasts in
# chat; email is silently skipped (look for "[notify] email skipped" in
# the server logs).
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# A verified sender on your Resend account, e.g. "Halo <halo@yourdomain.com>"
RESEND_FROM=
